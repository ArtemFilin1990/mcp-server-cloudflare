/**
 * Конфиг Cloudflare Worker для Telegram-бота с ИИ.
 * Перед деплоем замените id KV namespace и имя/роут для окружения.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "telegram-ai-bot-dev",
	"main": "src/index.ts",
	"compatibility_date": "2025-03-10",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "CHAT_KV",
			"id": "REPLACE_WITH_KV_NAMESPACE_ID"
		}
	],
	"vars": {
		"AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
		"SYSTEM_PROMPT": "Ты — полезный и краткий Telegram-ассистент. Отвечай на том же языке, что и пользователь. Укладывайся в 1500 символов, если пользователь не просит иначе.",
		"HISTORY_TURNS": "8"
	},
	"dev": {
		"port": 8977
	}
}
